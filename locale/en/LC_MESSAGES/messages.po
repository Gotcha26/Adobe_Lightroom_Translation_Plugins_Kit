msgstr "Multilingual translation manager"

#: tools/translator/main.py:241
msgid ""
"\n"
"Exemples:\n"
"  # Mode interactif\n"
"  python -m tools.translator.main\n"
"\n"
"  # Avec --plugin-path (structure __i18n_tmp__):\n"
"  python -m tools.translator.main compare --old ./old/en.txt --new ./new/en."
"txt --plugin-path ./plugin.lrplugin\n"
"  python -m tools.translator.main compare-langs --lang1 fr --lang2 de --"
"locales ./plugin.lrplugin --plugin-path ./plugin.lrplugin\n"
"  python -m tools.translator.main extract --plugin-path ./plugin.lrplugin --"
"locales ./plugin.lrplugin\n"
"  python -m tools.translator.main sync --plugin-path ./plugin.lrplugin --"
"locales ./plugin.lrplugin\n"
"\n"
"  # Mode legacy (sans plugin-path):\n"
"  python -m tools.translator.main compare --old ./v1/en.txt --new ./v2/en."
"txt\n"
"  python -m tools.translator.main compare-langs --file1 ./Locales/fr.txt --"
"file2 ./Locales/de.txt\n"
"  python -m tools.translator.main extract --update ./20260128_143000 --"
"locales ./Locales\n"
"  python -m tools.translator.main sync --update ./20260128_143000 --"
"locales ./Locales\n"
"\n"
"  # Commandes essentielles:\n"
"  python -m tools.translator.main install --plugin-path ./plugin.lrplugin\n"
"  python -m tools.translator.main addlang --plugin-path ./plugin.lrplugin --"
"lang de\n"
"  python -m tools.translator.main autosync --plugin-path ./plugin.lrplugin --"
"yes\n"
"        "
msgstr ""
"\n"
"Examples:\n"
"  # Interactive mode\n"
"  python -m tools.translator.main\n"
"\n"
"  # With --plugin-path (__i18n_tmp__ structure):\n"
"  python -m tools.translator.main compare --old ./old/en.txt --new ./new/en."
"txt --plugin-path ./plugin.lrplugin\n"
"  python -m tools.translator.main compare-langs --lang1 fr --lang2 de --"
"locales ./plugin.lrplugin --plugin-path ./plugin.lrplugin\n"
"  python -m tools.translator.main extract --plugin-path ./plugin.lrplugin --"
"locales ./plugin.lrplugin\n"
"  python -m tools.translator.main sync --plugin-path ./plugin.lrplugin --"
"locales ./plugin.lrplugin\n"
"\n"
"  # Legacy mode (without plugin-path):\n"
